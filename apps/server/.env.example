# ============================================================
# 服务端环境配置 —— 复制为 .env 后填写，.env 已被 .gitignore 忽略
# ============================================================

# 服务监听端口（Electron 打包时会由主进程动态指定）
PORT=7801

# 数据目录：SQLite / 日志 / 导出文件都放这里
# 留空则默认 <apps/server>/.data
DATA_DIR=

# SQLite 连接串（Prisma CLI 用；相对 prisma/ 目录解析，与 DATA_DIR 默认值保持一致）
DATABASE_URL="file:../.data/app.db"

# 凭证加密主密钥（32 字节 hex，64 字符）。留空则首次启动自动生成并落盘到 DATA_DIR/master.key
APP_MASTER_KEY=

# Prisma 引擎镜像（国内加速，可删）
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# ------------------------------------------------------------
# 快手磁力引擎开放平台 —— 也可以启动后在「设置」页里填，效果等同
# ------------------------------------------------------------
# 开发者应用 app_id
KUAI_APP_ID=
# 开发者应用 secret（只存在于后端，切勿提交到版本库）
KUAI_APP_SECRET=
# OAuth 回调地址，必须与开放平台「应用管理」里登记的一致
KUAI_REDIRECT_URI=http://localhost:7801/api/oauth/callback

# 前端开发服务器地址（用于 CORS 放行）
WEB_ORIGIN=http://localhost:5173
